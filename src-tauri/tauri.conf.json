{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roans Terminal",
  "version": "0.0.1",
  "identifier": "com.roanh47.roans-terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Roans Terminal",
        "width": 1280,
        "height": 800,
        "minWidth": 780,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NzY5OTc0NkFCQkRGMUQKUldRZDM3dHFkSmwyK1NuVjdIaG1hL1U0Y25UczJ3SFE5T3k4RFlWN0lpS3IyQ2tITzdWZkdtc0cK",
      "endpoints": [
        "https://github.com/roanh47/Roans-Terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
